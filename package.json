{
  "name": "chapter",
  "version": "0.0.0",
  "private": true,
  "description": "A private mood journal and habit tracker. Android and web, local-first.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "node tools/check-boundaries.mjs",
    "verify": "pnpm boundaries && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "expo": "~52.0.49",
    "expo-modules-core": "2.2.3",
    "react-native": "0.76.9",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
